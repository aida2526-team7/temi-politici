# Ambiente Python locale
.venv/
venv/
env/

# Cache e file compilati Python
__pycache__/
*.py[cod]
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Variabili d'ambiente e credenziali
.env
.env.*
!.env.example
credentials.json
service_account*.json
*.pem
*.key

# Configurazioni locali VS Code
.vscode/

# macOS
.DS_Store

# File temporanei
*.tmp
*.log
logs/

# Dati generati dalla pipeline (jsonl grezzi/full-text): rigenerabili, non versionati.
# I .gitkeep e i CSV di risultato (es. mediacloud_coverage.csv) restano tracciati.
data/raw/*.jsonl
data/processed/*.jsonl
data/processed/news_topic_review.csv
data/processed/news_topic_terms.csv
data/processed/topic_model_metadata.json
# Salienza dei temi dai sondaggi: dati proprietari (Ipsos). Versionarli richiede
# la revisione di compliance; per ora restano fuori da Git.
data/processed/sondaggi_salienza_temi.csv
.drive-export-dir

# Export scaricati da Drive: archivi transitori, si rigenerano dalla fonte.
DATI-*.zip

# Finanziamenti ai partiti: dato grezzo di un layer che l'ontologia non copre
# ancora. Fuori da Git finche' non c'e' una decisione su come entra nel piano.
data/raw/finanziamenti_partiti.*

# Discovery dai siti di partito: rigenerabile con run_programmi_discovery.py
data/raw/programmi_urls.jsonl

# Derivato dai dati Ipsos: segue la stessa regola della sorgente, resta fuori da
# Git finche' non c'e' la revisione di compliance. Si rigenera con
# scripts/run_intersezione_sondaggi.py.
reports/ontologia_mapping/intersezione_sondaggi.csv

# Pacchetti zip preparati per i revisori: duplicano file gia' tracciati e
# contengono estratti di articoli. Si rigenerano da annotations/validazione_lessico/.
annotations/*.zip

# Materiale per la presentazione in aula, non fa parte della pipeline:
# si rigenera con `py scripts/costruisci_slide.py`.
docs/slide/
scripts/costruisci_slide.py
